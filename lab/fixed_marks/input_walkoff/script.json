  "text": "",
  "line_id": "b36fdd1c-bf01-4a89-881b-4c433016f345"
 },
 {
  "kind": "action",
  "text": "Anudi smiles and looks at his small food business.",
  "line_id": null
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "d9b0ae30-cc02-408b-aee2-d6597e383a1a"
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "18c80995-e36e-49c4-bde0-6f1107e08558"
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "2256c767-cb90-48b3-ae46-c0631d5b02c7"
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "94896f20-a112-44aa-9429-1e0ced623ca7"
 },
 {
  "kind": "action",
  "text": "Anudi looks impressed.",
  "line_id": null
 },
 {
  "kind": "sound",
  "text": "Before she can continue the conversation, her phone suddenly rings.",
  "line_id": null
 },
 {
  "kind": "action",
  "text": "She checks the screen. It's her father.",
  "line_id": null
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "36232aa2-eab7-4b10-85a3-4598ca3fda5d"
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "3c1570ee-0fa5-41a4-b241-18120c2e85e0"
 },
 {
  "kind": "action",
  "text": "Anudi's smile slowly disappears.",
  "line_id": null
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "361a549f-68c4-45cb-88ec-91fcc78f4bfd"
 },
 {
  "kind": "action",
  "text": "She ends the call.Kasun notices her changed expression. Anudi looks at him again.",
  "line_id": null
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "8ec39c7e-0c43-4305-89cd-2ac3b86d4dd7"
 },
 {
  "kind": "dialogue",
  "text": "",
  "line_id": "b0bd4fa0-323d-48f3-9019-bb9f0d79bcb1"
 },
 {
  "kind": "action",
  "text": "Anudi walks toward her destination. Kasun watches her leave. After a moment, he returns to his small business, but his thoughts are somewhere else.",
  "line_id": null
 }
