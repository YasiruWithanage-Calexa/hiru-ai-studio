   "number": 1,
   "heading": "SCENE 01 — KASUN'S EVERYDAY LIFE",
   "title": "KASUN'S EVERYDAY LIFE",
   "location_id": "789c4670-f040-4df5-9887-88cc07b1e319",
   "time_of_day": "",
   "envelope_s": 28,
   "script": [
    {
     "kind": "action",
     "text": "Location: Colombo roadside – Food three-wheeler Duration: 0.46 minutes",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Early morning in Colombo. The city is waking up. Buses, tuk-tuks, motorcycles and office workers fill the streets.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun prepares his small three-wheeler food business. He arranges short eats, fills his tea flask and cleans his small counter.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "An office worker approaches and orders tea.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun smiles and serves him.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "After the customer leaves, Kasun looks at his small business. He notices the limited space and old equipment but doesn't lose hope.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He looks toward the busy road and quietly speaks to himself.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun:",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "04c14e9b-8a51-4e59-b479-05606d170fb7"
    },
    {
     "kind": "action",
     "text": "He smiles and continues working.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "04c14e9b-8a51-4e59-b479-05606d170fb7",
    "production_id": "lab",
    "scene_id": "f5743a68-716a-433e-a89c-d9320b098642",
    "ord": 0,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"දවසක මගේම රෙස්ටුරන්ට් එකක් පටන් ගන්නවා.\"",
    "delivery": "",
    "words": 6
   }
  ]
 },
 {
  "scene": {
   "id": "5900c2cb-d49f-499a-9698-a21f50d7b500",
   "production_id": "lab",
   "episode_id": "c2e0c64e-b277-4384-a36e-7e5e1b3c0074",
   "number": 2,
   "heading": "SCENE 02 — ANUDI ARRIVES",
   "title": "ANUDI ARRIVES",
   "location_id": "4009b5c5-b635-480c-a463-a68edcb7b747",
   "time_of_day": "",
   "envelope_s": 23,
   "script": [
    {
     "kind": "action",
     "text": "Location: Colombo road – Family car and roadside Duration: 0.38 minutes A comfortable family car moves through Colombo traffic. Anudi sits in the back seat, looking at her smartphone.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "The driver stops near an office building. Anudi gets out, carrying her handbag and umbrella. She thanks the driver and walks toward the building.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Rain begins to fall. She opens her umbrella and continues walking along the roadside, passing Kasun's small food three-wheeler.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
