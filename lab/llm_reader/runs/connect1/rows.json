 },
 {
  "scene": {
   "id": "9960be5f-baf5-463b-b549-eaab487cb5f0",
   "production_id": "lab",
   "episode_id": "c2e0c64e-b277-4384-a36e-7e5e1b3c0074",
   "number": 3,
   "heading": "SCENE 03 — THE UNEXPECTED ENCOUNTER",
   "title": "THE UNEXPECTED ENCOUNTER",
   "location_id": "090d107f-567f-4ee0-8f58-48751d1fa944",
   "time_of_day": "",
   "envelope_s": 17,
   "script": [
    {
     "kind": "action",
     "text": "Location: Colombo roadside – Near Kasun's food three-wheeler Duration: 0.29 minutes",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Anudi walks past Kasun's three-wheeler while holding her umbrella. She tries to put her smartphone into the side pocket of her handbag.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "As she slips the phone into the bag, it accidentally slips from her hand and falls onto the roadside. Anudi doesn't notice and continues walking.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun notices the phone lying on the ground. He quickly picks it up and runs after her.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun:",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "313bb356-c935-46d4-8cfc-5b1c04373a34"
    },
    {
     "kind": "action",
     "text": "Anudi hears him and turns around. Kasun approaches her, holding out the phone.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "313bb356-c935-46d4-8cfc-5b1c04373a34",
    "production_id": "lab",
    "scene_id": "9960be5f-baf5-463b-b549-eaab487cb5f0",
    "ord": 0,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"මිස්! මිස්! ඔයාගේ ෆෝන් එක!\"",
    "delivery": "",
    "words": 5
   }
  ]
 },
 {
  "scene": {
   "id": "d69085de-8420-4184-9d09-6099f4406273",
   "production_id": "lab",
   "episode_id": "c2e0c64e-b277-4384-a36e-7e5e1b3c0074",
   "number": 4,
   "heading": "SCENE 04 — A CONVERSATION THAT CHANGES EVERYTHING",
   "title": "A CONVERSATION THAT CHANGES EVERYTHING",
   "location_id": "090d107f-567f-4ee0-8f58-48751d1fa944",
   "time_of_day": "",
   "envelope_s": 45,
   "script": [
    {
     "kind": "action",
     "text": "Anudi takes her phone from Kasun.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "da7abbf6-df3b-45bb-b4db-646cc99f1def"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "dd86785c-b5b1-49cd-b03a-cfcc411c1876"
    },
    {
     "kind": "action",
     "text": "Anudi smiles and looks at his small food business.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "947b796e-93be-4a71-941f-964b2ccae850"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "518561a2-f42b-4cd4-b373-b2ee416a1ea1"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "16ddde2a-8c38-46c1-8674-4adb70e16a72"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "64ce7a3c-c84e-495e-b58b-e990c7bfab69"
    },
    {
     "kind": "action",
     "text": "Anudi looks impressed.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Before she can continue the conversation, her phone suddenly rings. She checks the screen. It's her father.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "bf0dcdfb-1651-4672-a3ae-e245046e885b"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "2384b912-cd09-4bd4-890d-c2b67b5d4132"
    },
    {
     "kind": "action",
     "text": "Anudi's smile slowly disappears.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "c09fee9e-222e-4745-83c0-18c01be42402"
    },
    {
     "kind": "action",
     "text": "She ends the call. Kasun notices her changed expression. Anudi looks at him again.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "d13e9f96-c65f-404b-a803-996dd277a093"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "6f146296-b0c0-4b3f-968f-9b04417eeb93"
    },
    {
     "kind": "action",
     "text": "Anudi walks toward her destination. Kasun watches her leave. After a moment, he returns to his small business, but his thoughts are somewhere else.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Location: Colombo roadside – Near Kasun's food three-wheeler Duration: 0.75 minutes Anudi: Kasun: Anudi: Kasun: Anudi: Kasun: Anudi: Father (over the phone): Anudi: Anudi: Kasun:",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "da7abbf6-df3b-45bb-b4db-646cc99f1def",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 0,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"අනේ, Thank you! මම දැක්කෙවත් නෑ.\"",
    "delivery": "",
    "words": 6
   },
   {
    "id": "dd86785c-b5b1-49cd-b03a-cfcc411c1876",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 1,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"වැස්ස නිසා වෙන්න ඇති.\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "947b796e-93be-4a71-941f-964b2ccae850",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 2,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"මේ ඔයාගේ බිස්නස් එකද?\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "518561a2-f42b-4cd4-b373-b2ee416a1ea1",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 3,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"ඔව්. පොඩියට පටන් ගත්තේ.\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "16ddde2a-8c38-46c1-8674-4adb70e16a72",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 4,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"තනියමද මේ හැමදේම කරන්නේ?\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "64ce7a3c-c84e-495e-b58b-e990c7bfab69",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 5,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"ඔව්. රුපියල් පන්දහසකින් පටන් ගත්තේ. තව ඉස්සරහට යන්න තමයි බලාපොරොත්තුව.\"",
    "delivery": "",
    "words": 10
   },
   {
    "id": "bf0dcdfb-1651-4672-a3ae-e245046e885b",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 6,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"හෙලෝ තාත්තේ.\"",
    "delivery": "",
    "words": 2
   },
   {
    "id": "2384b912-cd09-4bd4-890d-c2b67b5d4132",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 7,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"අනුදි, ඔයා කොහෙද ඉන්නේ? ඉක්මනට ගෙදර එන්න. අපිට ඔයාගේ කසාදෙ ගැන කතා කරන්න තියෙනවා.\"",
    "delivery": "on the phone",
    "words": 14
   },
   {
    "id": "c09fee9e-222e-4745-83c0-18c01be42402",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 8,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"හරි තාත්තේ. මම එන්නම්.\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "d13e9f96-c65f-404b-a803-996dd277a093",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 9,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"එහෙනම් මම යන්නම්. ආයෙත් හම්බවෙමු.\"",
    "delivery": "",
    "words": 5
   },
   {
    "id": "6f146296-b0c0-4b3f-968f-9b04417eeb93",
    "production_id": "lab",
    "scene_id": "d69085de-8420-4184-9d09-6099f4406273",
    "ord": 10,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"හරි. පරිස්සමින් යන්න.\"",
    "delivery": "",
    "words": 3
   }
  ]
 },
 {
  "scene": {
   "id": "931f6faf-1dad-4ba9-afdb-0f86ec31d50b",
   "production_id": "lab",
   "episode_id": "beb38563-e178-4498-be0c-7e1ee6f13acd",
   "number": 1,
   "heading": "SCENE 01 — A FAMILIAR FACE",
   "title": "A FAMILIAR FACE",
   "location_id": "789c4670-f040-4df5-9887-88cc07b1e319",
   "time_of_day": "",
   "envelope_s": 32,
   "script": [
    {
     "kind": "action",
     "text": "Location: Kasun's food three-wheeler – Different evenings Duration: 0.54 minutes A few weeks have passed. Kasun is serving customers as usual. Suddenly, a familiar voice interrupts him. Anudi:",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "fd48af7a-b745-4c22-9b3b-6218e4d2951f"
    },
    {
     "kind": "action",
     "text": "Kasun looks up and smiles. Kasun:",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "37a874a2-5034-4553-9b82-4dde1868bff5"
    },
    {
     "kind": "action",
     "text": "They laugh. Anudi takes a seat beside the three-wheeler. This becomes a regular routine.",
     "line_id": null
    },
    {
     "kind": "cut",
     "text": "A romantic montage follows:",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Anudi visits Kasun after work.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun prepares her favourite tea. They spend time talking and laughing. Anudi helps him arrange food containers.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun walks with her to her car. They exchange smiles before saying goodbye. Over these repeated meetings, their friendship gradually develops into love.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "fd48af7a-b745-4c22-9b3b-6218e4d2951f",
    "production_id": "lab",
    "scene_id": "931f6faf-1dad-4ba9-afdb-0f86ec31d50b",
    "ord": 0,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"අදත් තේ එකක් ගන්න පුළුවන්ද?\"",
    "delivery": "",
    "words": 5
   },
   {
    "id": "37a874a2-5034-4553-9b82-4dde1868bff5",
    "production_id": "lab",
    "scene_id": "931f6faf-1dad-4ba9-afdb-0f86ec31d50b",
    "ord": 1,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"අද නම් තේ එක විතරක් නෙවෙයි. Short eats තියෙනවා.\"",
    "delivery": "",
    "words": 9
   }
  ]
 },
 {
  "scene": {
   "id": "b2f13165-1bd3-4f64-adf2-3c193081f28d",
   "production_id": "lab",
   "episode_id": "beb38563-e178-4498-be0c-7e1ee6f13acd",
   "number": 2,
   "heading": "SCENE 02 — THE FATHER NOTICES",
   "title": "THE FATHER NOTICES",
   "location_id": "090d107f-567f-4ee0-8f58-48751d1fa944",
   "time_of_day": "",
   "envelope_s": 23,
   "script": [
    {
     "kind": "action",
     "text": "Location: Colombo roadside – Evening Duration: 0.38 minutes One evening, Anudi is talking and laughing with Kasun beside his three-wheeler. Her father's car passes by.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He notices Anudi standing beside the small roadside business. He asks the driver to slow down. From inside the car, he observes them for a moment.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "His expression changes when he sees the condition of Kasun's business. He doesn't confront them immediately. He continues driving, but his mind is troubled.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": []
 },
 {
  "scene": {
   "id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
   "production_id": "lab",
   "episode_id": "beb38563-e178-4498-be0c-7e1ee6f13acd",
   "number": 3,
   "heading": "SCENE 03 — THE CONFRONTATION",
   "title": "THE CONFRONTATION",
   "location_id": "8679d1d7-97be-4ea0-8e61-69c2b5fc421d",
   "time_of_day": "",
   "envelope_s": 38,
   "script": [
    {
     "kind": "action",
     "text": "That night. Anudi is sitting comfortably on the sofa, looking at her phone. Her father enters the living room with a serious expression. He sits opposite her.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "3baa9920-b0dc-4a92-b74b-8bc6006401db"
    },
    {
     "kind": "action",
     "text": "Anudi looks up.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "de09fdbd-9b02-42d7-9176-05ad6c9fc64b"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "58afbcaf-e246-416e-84f3-70aa3a714798"
    },
    {
     "kind": "action",
     "text": "Anudi becomes slightly uncomfortable.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "f7fcf2b9-1630-4d90-ae3d-7d0a040c9f0a"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "92a4a1b3-0550-49c4-bab9-9ff450f03038"
    },
    {
     "kind": "action",
     "text": "Anudi looks disappointed.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "63632b0b-6088-4d80-aa64-b51ebd48aab7"
    },
    {
     "kind": "action",
     "text": "Her father responds immediately.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "d7706ba3-e27a-40b8-aeca-a9bdfd480562"
    },
    {
     "kind": "action",
     "text": "Anudi looks at her father. She wants to argue, but decides to remain silent. She gets up and walks away. Her father remains seated, convinced that he is protecting his daughter.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Location: Anudi's family home – Living room Duration: 0.63 minutes Father: Anudi: Father: Anudi: Father: Anudi: Father:",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "3baa9920-b0dc-4a92-b74b-8bc6006401db",
    "production_id": "lab",
    "scene_id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
    "ord": 0,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"අද මම ඔයාව දැක්කා අර කොල්ලා එක්ක.\"",
    "delivery": "",
    "words": 7
   },
   {
    "id": "de09fdbd-9b02-42d7-9176-05ad6c9fc64b",
    "production_id": "lab",
    "scene_id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
    "ord": 1,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"කවුද තාත්තේ?\"",
    "delivery": "",
    "words": 2
   },
   {
    "id": "58afbcaf-e246-416e-84f3-70aa3a714798",
    "production_id": "lab",
    "scene_id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
    "ord": 2,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"අර පාරේ කෑම විකුණන කොල්ලා. ඒ ළමයා කවුද?\"",
    "delivery": "",
    "words": 8
   },
   {
    "id": "f7fcf2b9-1630-4d90-ae3d-7d0a040c9f0a",
    "production_id": "lab",
    "scene_id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
    "ord": 3,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"තාත්තේ, එයා කසුන්. මගේ යාළුවෙක්.\"",
    "delivery": "",
    "words": 5
   },
   {
    "id": "92a4a1b3-0550-49c4-bab9-9ff450f03038",
    "production_id": "lab",
    "scene_id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
    "ord": 4,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"යාළුවෙක් විතරද? ඒ ළමයට මොනවද තියෙන්නේ? තමන්ගේ කියලා හරියට තැනක්වත් නෑ.\"",
    "delivery": "",
    "words": 11
   },
   {
    "id": "63632b0b-6088-4d80-aa64-b51ebd48aab7",
    "production_id": "lab",
    "scene_id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
    "ord": 5,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"එයාට හීනයක් තියෙනවා තාත්තේ.\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "d7706ba3-e27a-40b8-aeca-a9bdfd480562",
    "production_id": "lab",
    "scene_id": "6dd6b6d2-aff6-4e98-a302-94ac8e4c3854",
    "ord": 6,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"හීනවලින් පවුල් ජීවත් කරන්න බෑ අනුදි. සල්ලි ඕනේ. අනාගතයක් තියෙන්න ඕනේ.\"",
    "delivery": "",
    "words": 11
   }
  ]
 },
 {
  "scene": {
   "id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
   "production_id": "lab",
   "episode_id": "beb38563-e178-4498-be0c-7e1ee6f13acd",
   "number": 4,
   "heading": "SCENE 04 — KASUN'S DETERMINATION AND THE BIG OPPORTUNITY",
   "title": "KASUN'S DETERMINATION AND THE BIG OPPORTUNITY",
   "location_id": "52071d55-49c8-4bb2-8ce3-17820fcea54d",
   "time_of_day": "",
   "envelope_s": 60,
   "script": [
    {
     "kind": "action",
     "text": "Late at night. Kasun is working in his small rented workspace. The room contains stainless-steel cooking equipment, food containers, business receipts and a small table. He checks his orders, calculates expenses and writes figures in a notebook. His business has started growing. He is now supplying food to three small shops.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Anudi arrives and notices how tired he looks. She looks around the workspace.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "216a3ed6-455c-4bbb-af3a-0b901b758857"
    },
    {
     "kind": "action",
     "text": "",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "b1c97643-7be9-4819-967e-7396151ddac0"
    },
    {
     "kind": "action",
     "text": "Anudi gently holds his hand.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "632e085d-97dc-42cb-999a-1f58ba167e5f"
    },
    {
     "kind": "action",
     "text": "",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "8a1578c5-feb3-4946-b033-6ba3dce4f555"
    },
    {
     "kind": "action",
     "text": "Suddenly, Kasun's phone rings. He checks the number and answers.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "e4d53541-e8e1-4f8a-863c-7920e3fe8fd9"
    },
    {
     "kind": "action",
     "text": "A representative from a major supermarket chain is on the other end.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "6c7ec531-d297-4b70-92ff-10e812d8f65d"
    },
    {
     "kind": "action",
     "text": "",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "1208558e-db5c-4fd9-b703-218d628063bc"
    },
    {
     "kind": "action",
     "text": "",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "a18c3e52-49a9-4786-bc8d-14fe8d631afb"
    },
    {
     "kind": "action",
     "text": "",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "35889e68-d2a5-4ed3-bae7-b024cde58865"
    },
    {
     "kind": "action",
     "text": "He looks at her with excitement.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "But as he returns to his notebook and calculates the expansion costs, his expression slowly changes.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "The supermarket order requires a major investment. He needs Rs. 2 million. He looks at the numbers again. He doesn't have enough money. Anudi notices his silence.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Location: Kasun's small food preparation workspace Duration: 1 minute Anudi: Kasun: Anudi: Kasun: Kasun: Representative (over the phone): Kasun: Anudi: Kasun:",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "216a3ed6-455c-4bbb-af3a-0b901b758857",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 0,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"ඇයි ඔයා මේ තරම් මහන්සි වෙන්නේ?\"",
    "delivery": "",
    "words": 6
   },
   {
    "id": "b1c97643-7be9-4819-967e-7396151ddac0",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 1,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"මට ඔයාගේ පවුලෙන් කවදාවත් ඔයාට මම ගැළපෙන්නේ නෑ කියලා අහන්න ඕනේ නෑ.\"",
    "delivery": "",
    "words": 12
   },
   {
    "id": "632e085d-97dc-42cb-999a-1f58ba167e5f",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 2,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"මට ඔයාගේ සල්ලි ඕනේ නෑ කසුන්. මට ඔයාවයි ඕනේ.\"",
    "delivery": "",
    "words": 9
   },
   {
    "id": "8a1578c5-feb3-4946-b033-6ba3dce4f555",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 3,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"ඒත් මට ඕනේ ඔයාට හොඳ අනාගතයක් දෙන්න.\"",
    "delivery": "",
    "words": 7
   },
   {
    "id": "e4d53541-e8e1-4f8a-863c-7920e3fe8fd9",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 4,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"හෙලෝ, කසුන් කතා කරන්නේ.\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "6c7ec531-d297-4b70-92ff-10e812d8f65d",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 5,
    "speaker": "representative",
    "character_id": "2fbea409-dfca-4f7e-9781-a658848fdfb2",
    "text": "\"ඔයාලගේ food products අපේ branches කිහිපයකට supply කරන්න අපි කැමතියි. ඒ ගැන කතා කරන්න පුළුවන්ද?\"",
    "delivery": "on the phone",
    "words": 15
   },
   {
    "id": "1208558e-db5c-4fd9-b703-218d628063bc",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 6,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"ඇත්තටම සර්? ඒක ලොකු අවස්ථාවක්.\"",
    "delivery": "",
    "words": 5
   },
   {
    "id": "a18c3e52-49a9-4786-bc8d-14fe8d631afb",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 7,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"මොකද වුණේ?\"",
    "delivery": "",
    "words": 2
   },
   {
    "id": "35889e68-d2a5-4ed3-bae7-b024cde58865",
    "production_id": "lab",
    "scene_id": "fef2ea91-1f95-4635-9836-352f53b15d5a",
    "ord": 8,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"අනුදි... අපිට ලොකු order එකක් ලැබෙන්න යන්නේ.\"",
    "delivery": "",
    "words": 7
   }
  ]
 },
 {
  "scene": {
   "id": "da8a6313-9176-4d48-aa23-941e05296b4c",
   "production_id": "lab",
   "episode_id": "361f1f72-a8f1-4447-898f-e362e1c673a0",
   "number": 1,
   "heading": "SCENE 01 — THE STRUGGLE",
   "title": "THE STRUGGLE",
   "location_id": "52071d55-49c8-4bb2-8ce3-17820fcea54d",
   "time_of_day": "",
   "envelope_s": 32,
   "script": [
    {
     "kind": "action",
     "text": "Kasun is determined to secure the Rs. 2 million needed to expand his business. A sequence of connected moments shows his struggle.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He visits a bank and discusses a business loan.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He sits with a potential investor and explains his business plan.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He makes phone calls to friends asking for financial support.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He reviews his business documents and calculations late at night.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Each attempt ends in disappointment. The bank cannot offer the required support. The investor doesn't believe the small business can handle such a large order. His friends are unable to help.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Finally, Kasun returns to his small workspace. He sits alone at the desk, looking at the supermarket order and the financial calculations.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He realizes that his biggest opportunity may disappear because he cannot find the money.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": []
 },
 {
  "scene": {
   "id": "205c6489-3da0-49da-9fc8-d5c825feef68",
   "production_id": "lab",
   "episode_id": "361f1f72-a8f1-4447-898f-e362e1c673a0",
   "number": 2,
   "heading": "SCENE 02 — ANUDI'S SUPPORT",
   "title": "ANUDI'S SUPPORT",
   "location_id": "68c93670-a374-4da0-9bb5-a9790c601f4b",
   "time_of_day": "",
   "envelope_s": 23,
   "script": [
    {
     "kind": "action",
     "text": "Anudi sits alone in her bedroom. She looks at a photograph of herself and Kasun.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Her phone rings. It is Kasun.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "10951fcf-c5c2-4ed6-b383-5374cdb33732"
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "63a3818b-b26a-4124-9fb3-def037964aff"
    },
    {
     "kind": "action",
     "text": "Anudi sounds concerned.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "2b756681-8418-45ed-b3d7-59b16c188cf6"
    },
    {
     "kind": "action",
     "text": "Kasun smiles slightly.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "6b58342d-da5a-4edd-aaac-ac27c5d3c5b3"
    },
    {
     "kind": "action",
     "text": "They end the call. Anudi looks worried but continues believing in him.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "10951fcf-c5c2-4ed6-b383-5374cdb33732",
    "production_id": "lab",
    "scene_id": "205c6489-3da0-49da-9fc8-d5c825feef68",
    "ord": 0,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"කොහොමද කසුන්? වැඩේ හරියනවද?\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "63a3818b-b26a-4124-9fb3-def037964aff",
    "production_id": "lab",
    "scene_id": "205c6489-3da0-49da-9fc8-d5c825feef68",
    "ord": 1,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"තාම හරියට විසඳුමක් නෑ අනුදි. බැංකුවෙන්වත් investor කෙනෙක්ගෙන්වත් උදව්වක් ලැබුණේ නෑ.\"",
    "delivery": "on the phone",
    "words": 11
   },
   {
    "id": "2b756681-8418-45ed-b3d7-59b16c188cf6",
    "production_id": "lab",
    "scene_id": "205c6489-3da0-49da-9fc8-d5c825feef68",
    "ord": 2,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"හැමදේම හරියයි කසුන්. ඔයා උත්සාහය අතාරින්න එපා.\"",
    "delivery": "",
    "words": 7
   },
   {
    "id": "6b58342d-da5a-4edd-aaac-ac27c5d3c5b3",
    "production_id": "lab",
    "scene_id": "205c6489-3da0-49da-9fc8-d5c825feef68",
    "ord": 3,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"මම උත්සාහ කරනවා අනුදි.\"",
    "delivery": "on the phone",
    "words": 4
   }
  ]
 },
 {
  "scene": {
   "id": "f331f01f-0f48-490f-a40c-bc60be7ef708",
   "production_id": "lab",
   "episode_id": "361f1f72-a8f1-4447-898f-e362e1c673a0",
   "number": 3,
   "heading": "SCENE 03 — AN UNEXPECTED OFFER",
   "title": "AN UNEXPECTED OFFER",
   "location_id": "52071d55-49c8-4bb2-8ce3-17820fcea54d",
   "time_of_day": "",
   "envelope_s": 38,
   "script": [
    {
     "kind": "action",
     "text": "Kasun is reviewing business documents at his small desk.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Someone arrives. It is Anudi's father. Kasun stands up respectfully.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "c6b1dbf2-8aef-4a06-b3fe-1cb7e71e4981"
    },
    {
     "kind": "action",
     "text": "The father sits down. He looks around the small workspace. He notices the business documents, food containers and calculations on the table.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He takes an envelope from his bag and places it on the table. Kasun looks at it.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "0250f085-d6b5-4094-ac0a-fc45063be9b0"
    },
    {
     "kind": "action",
     "text": "Kasun looks surprised. He opens the envelope and sees the cheque.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "1a4c466e-9cd1-4ce4-b117-03125f6a99fa"
    },
    {
     "kind": "action",
     "text": "The father looks directly at him.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "b6549b05-e8f9-4250-81a8-22edbdac1250"
    },
    {
     "kind": "action",
     "text": "Kasun looks up.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "0a0b70f9-ab01-4e1c-9012-8044cd15e51f"
    },
    {
     "kind": "sound",
     "text": "Silence.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun's smile disappears. He looks at the cheque and then at Anudi's father.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "c6b1dbf2-8aef-4a06-b3fe-1cb7e71e4981",
    "production_id": "lab",
    "scene_id": "f331f01f-0f48-490f-a40c-bc60be7ef708",
    "ord": 0,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"ආයුබෝවන් සර්. වාඩිවෙන්න.\"",
    "delivery": "",
    "words": 3
   },
   {
    "id": "0250f085-d6b5-4094-ac0a-fc45063be9b0",
    "production_id": "lab",
    "scene_id": "f331f01f-0f48-490f-a40c-bc60be7ef708",
    "ord": 1,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"මේකේ රුපියල් මිලියන දෙකක් තියෙනවා.\"",
    "delivery": "",
    "words": 5
   },
   {
    "id": "1a4c466e-9cd1-4ce4-b117-03125f6a99fa",
    "production_id": "lab",
    "scene_id": "f331f01f-0f48-490f-a40c-bc60be7ef708",
    "ord": 2,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"බොහොම ස්තූතියි සර්. මේක මට ලොකු උදව්වක්.\"",
    "delivery": "",
    "words": 7
   },
   {
    "id": "b6549b05-e8f9-4250-81a8-22edbdac1250",
    "production_id": "lab",
    "scene_id": "f331f01f-0f48-490f-a40c-bc60be7ef708",
    "ord": 3,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"හැබැයි එක කොන්දේසියක් තියෙනවා.\"",
    "delivery": "",
    "words": 4
   },
   {
    "id": "0a0b70f9-ab01-4e1c-9012-8044cd15e51f",
    "production_id": "lab",
    "scene_id": "f331f01f-0f48-490f-a40c-bc60be7ef708",
    "ord": 4,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"ඔයා මගේ දුවගෙන් ඈත් වෙන්න ඕනේ.\"",
    "delivery": "",
    "words": 6
   }
  ]
 },
 {
  "scene": {
   "id": "7006d7e2-dee1-4e4f-bf85-784c92961f57",
   "production_id": "lab",
   "episode_id": "361f1f72-a8f1-4447-898f-e362e1c673a0",
   "number": 4,
   "heading": "SCENE 04 — THE CHOICE",
   "title": "THE CHOICE",
   "location_id": "52071d55-49c8-4bb2-8ce3-17820fcea54d",
   "time_of_day": "",
   "envelope_s": 32,
   "script": [
    {
     "kind": "action",
     "text": "Kasun remains silent for a moment. He looks at the cheque.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He knows how much his business needs this money.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "He looks at the business documents on the table. Then he slowly pushes the cheque back toward Anudi's father.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "47ebcabf-e06b-489c-85ec-b1cae1a4b203"
    },
    {
     "kind": "action",
     "text": "The father looks surprised. Kasun takes a breath.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "071aa71d-45cf-417c-b9ee-76ed3bb3a815"
    },
    {
     "kind": "action",
     "text": "He stands up.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "d8a69378-ef14-4551-b495-859b071bd058"
    },
    {
     "kind": "action",
     "text": "Kasun respectfully walks away. The father remains seated. He looks at the cheque and then around the small workspace.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "For the first time, he begins to question his judgment about Kasun.",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "47ebcabf-e06b-489c-85ec-b1cae1a4b203",
    "production_id": "lab",
    "scene_id": "7006d7e2-dee1-4e4f-bf85-784c92961f57",
    "ord": 0,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"සර්... මට ඕනේ අනුදිව මිසක් ඔයාගේ සල්ලි නෙවෙයි.\"",
    "delivery": "",
    "words": 8
   },
   {
    "id": "071aa71d-45cf-417c-b9ee-76ed3bb3a815",
    "production_id": "lab",
    "scene_id": "7006d7e2-dee1-4e4f-bf85-784c92961f57",
    "ord": 1,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"මගේ ව්‍යාපාරය මමම ගොඩනගා ගන්නම්. ඒත් මගේ ආදරේ සල්ලිවලට අතාරින්න මට බෑ.\"",
    "delivery": "",
    "words": 12
   },
   {
    "id": "d8a69378-ef14-4551-b495-859b071bd058",
    "production_id": "lab",
    "scene_id": "7006d7e2-dee1-4e4f-bf85-784c92961f57",
    "ord": 2,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"මට සමාවෙන්න සර්.\"",
    "delivery": "",
    "words": 3
   }
  ]
 },
 {
  "scene": {
   "id": "aae67dad-8232-4638-8747-eb17af1ad5be",
   "production_id": "lab",
   "episode_id": "361f1f72-a8f1-4447-898f-e362e1c673a0",
   "number": 5,
   "heading": "SCENE 05 — A DREAM COMES TRUE",
   "title": "A DREAM COMES TRUE",
   "location_id": "3dd79d89-3b00-457a-83ae-81c28dd40a3c",
   "time_of_day": "",
   "envelope_s": 50,
   "script": [
    {
     "kind": "cut",
     "text": "Several months later.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "A modern but welcoming Sri Lankan restaurant is ready to open. The restaurant sign reads:",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "KASUN'S — SRI LANKAN FOOD & COFFEE",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "The restaurant is busy. Staff members are serving customers. The interior has warm lighting, wooden tables and Sri Lankan-inspired design.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "Kasun, now dressed in smart-casual clothing, stands proudly near the entrance. Anudi stands beside him. She looks around the restaurant and smiles.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "fa9421d3-cf36-47f9-8b3c-273e26d45227"
    },
    {
     "kind": "action",
     "text": "Kasun smiles.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "3832f48f-03dd-4227-8119-31f962ddbae8"
    },
    {
     "kind": "action",
     "text": "Suddenly, Kasun notices someone approaching. It is Anudi's father. He slowly walks toward them. He looks around the successful restaurant and then at Kasun.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "77af6b89-8616-455f-92bc-23d9e3d70511"
    },
    {
     "kind": "action",
     "text": "Kasun listens respectfully.",
     "line_id": null
    },
    {
     "kind": "dialogue",
     "text": "",
     "line_id": "1d6b7288-0dca-4c76-972c-00267534939a"
    },
    {
     "kind": "action",
     "text": "He extends his hand. Kasun shakes it. Anudi smiles emotionally. The three of them stand together beneath the restaurant sign.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "The camera slowly pulls back, revealing the restaurant and its customers.",
     "line_id": null
    },
    {
     "kind": "action",
     "text": "FINAL TEXT ON SCREEN: \"සමහර ආදර කතාවලට සල්ලි ඕනේ නෑ. තමන්ගේ හීන විශ්වාස කරන කෙනෙක් හිටියම ඇති.\"",
     "line_id": null
    }
   ],
   "script_version": 1,
   "status": "draft",
   "fit_report": {}
  },
  "dialogue_lines": [
   {
    "id": "fa9421d3-cf36-47f9-8b3c-273e26d45227",
    "production_id": "lab",
    "scene_id": "aae67dad-8232-4638-8747-eb17af1ad5be",
    "ord": 0,
    "speaker": "Anudi",
    "character_id": "3c1d6e4f-d602-4f1d-96d7-8e06d93bceff",
    "text": "\"ඔයාගේ හීනේ ඇත්තටම හැබෑ වුණා කසුන්.\"",
    "delivery": "",
    "words": 6
   },
   {
    "id": "3832f48f-03dd-4227-8119-31f962ddbae8",
    "production_id": "lab",
    "scene_id": "aae67dad-8232-4638-8747-eb17af1ad5be",
    "ord": 1,
    "speaker": "Kasun",
    "character_id": "b3393346-9623-4cca-a1e1-61c8bc52da44",
    "text": "\"ඔයා මාව විශ්වාස කළ නිසා.\"",
    "delivery": "",
    "words": 5
   },
   {
    "id": "77af6b89-8616-455f-92bc-23d9e3d70511",
    "production_id": "lab",
    "scene_id": "aae67dad-8232-4638-8747-eb17af1ad5be",
    "ord": 2,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"මට සමාවෙන්න පුතා. මම එදා වැරදියට හිතුවේ.\"",
    "delivery": "",
    "words": 7
   },
   {
    "id": "1d6b7288-0dca-4c76-972c-00267534939a",
    "production_id": "lab",
    "scene_id": "aae67dad-8232-4638-8747-eb17af1ad5be",
    "ord": 3,
    "speaker": "Father",
    "character_id": "f1eb06f6-740c-4c55-bf33-0999aa0d7619",
    "text": "\"ඔයාට සාර්ථක වෙන්න මගේ සල්ලි ඕනේ වුණේ නෑ. ඔයාට ඕනේ වුණේ ඔයා ගැන විශ්වාස කරන කෙනෙක් විතරයි.\"",
    "delivery": "",
    "words": 17
   }
  ]
 }
