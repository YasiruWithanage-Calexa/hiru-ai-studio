     {
      "kind": "action",
      "line_id": null,
      "text": "Kasun smiled."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:21>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Suddenly, his phone rang."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "It was a major supermarket chain."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "They wanted to place a huge order."
