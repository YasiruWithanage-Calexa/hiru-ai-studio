     {
      "kind": "action",
      "line_id": null,
      "text": "He had started supplying his food to three small shops."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "One evening, Anudi visited him at his small workspace."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:18>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Kasun looked at her."
