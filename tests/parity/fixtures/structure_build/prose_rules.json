     {
      "kind": "action",
      "line_id": null,
      "text": "It was raining heavily in Colombo."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Kasun stood beside his small three-wheeler, selling homemade short eats and tea to office workers."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "His clothes were simple, but his eyes were full of ambition. “One day… I'll have my own restaurant,” he told himself."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Across the road, Anudi stepped out of a comfortable family car, dressed elegantly and holding an umbrella."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "She accidentally dropped her phone near Kasun's three-wheeler."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Kasun picked it up and ran after her."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:9>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Anudi turned around."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:10>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "She looked at his little business."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:11>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Kasun smiled."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:12>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Anudi smiled back."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Suddenly, her phone rang."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "It was her father."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:13>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Her smile disappeared."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "She looked at Kasun one more time."
     },
     {
      "kind": "dialogue",
      "line_id": "<id:14>",
      "text": ""
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "She walked away."
     },
     {
      "kind": "action",
      "line_id": null,
      "text": "Kasun watched her leave."
     },
     {
      "kind": "action",
      "line_id": null,
