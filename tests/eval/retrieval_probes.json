    {"id": "lighthouse", "query": "What does the lighthouse look like?",
     "expect": [{"file": "harbour-lights-bible.md", "heading": "World"},
                {"file": "harbour-lights-canon-index.md", "heading": "Locations"}]},
    {"id": "storm", "query": "What happens during the storm?",
     "expect": [{"file": "harbour-lights-outline.txt"}]},
    {"id": "tide-notebook", "query": "Sunil's notebook of tides",
