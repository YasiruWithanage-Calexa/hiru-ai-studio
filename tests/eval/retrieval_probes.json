    {"id": "nimal-watch", "query": "Nimal's watch",
     "expect": [{"file": "harbour-lights-bible.md", "heading": "Nimal"},
                {"file": "harbour-lights-canon-index.md", "heading": "Characters"}]},
    {"id": "episode-count", "query": "How many episodes and how long is each?",
     "expect": [{"file": "harbour-lights-bible.md", "heading": "Format"}]},
    {"id": "sparse-dialogue", "query": "should the characters explain their feelings out loud",
     "expect": [{"file": "director-notes.txt"},
                {"file": "harbour-lights-bible.md", "heading": "Tone"}]}
