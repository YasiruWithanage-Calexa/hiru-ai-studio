    {"id": "sinhala-line", "query": "බෝට්ටුව විකුණන්න එපා",
     "expect": [{"file": "harbour-lights-ep01-script.fountain", "heading": "FRONT YARD"}]},
    {"id": "canon-code", "query": "C03",
     "expect": [{"file": "harbour-lights-canon-index.md", "heading": "Characters"}]},
    {"id": "hotel-agent", "query": "a hotel agent offers cash",
