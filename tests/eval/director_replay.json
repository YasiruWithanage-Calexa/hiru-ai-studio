     "message": "shot 1 wide",
     "expect": {"lane": "edit", "ops": [{"op": "set", "shot": 1, "field": "framing", "value": "WIDE"}]}},
    {"id": "reaction-insert", "split": "tune", "rules": true, "scene": 0,
