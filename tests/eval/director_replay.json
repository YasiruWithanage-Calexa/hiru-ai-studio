       {"person": "do it", "model": {"turn_plan": {"lane": "chat", "ops": [], "tasks": [], "memory": [], "cannot": null, "translate": null}, "reply": "Your earlier Sinhala switch is already applied."}, "expect": {"outcome": "chat", "no_ops": true, "card": false, "reply_has": ["nothing waiting"], "no_unbacked_promise": true}},
