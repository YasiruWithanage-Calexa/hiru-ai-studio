       {"person": "no still dialogues are in english", "model": {"turn_plan": {"lane": "chat", "ops": [], "tasks": [], "memory": [], "cannot": null, "translate": null}, "reply": "Say the word and I'll apply it."}, "expect": {"no_ops": true, "card": false, "end_state": {"dialogue_script": "si"}, "reply_has": ["already in Sinhala"], "no_unbacked_promise": true, "claims_match_state": true}},
