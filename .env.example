# Copy to .env and fill in. Nested settings use "__" (SUPABASE__URL -> settings.supabase.url).
# Priority: environment variables > .env > code defaults. In production, values come from
# Secret Manager through Cloud Run environment bindings; there is no .env in the container.

ENVIRONMENT=local

# --- Supabase: the hosted dev project is the ONE dev database (Database/README.md) --------
SUPABASE__URL=https://dwivfkavmtjzhypqswze.supabase.co
# The secret key (sb_secret_..., Dashboard > Settings > API Keys); a legacy service_role key also works.
# service_role key. Server-side only; never sent to a browser. Also the root of the file
# ticket key (see api/services/media_links.py), so rotating it invalidates every ticket.
SUPABASE__SERVICE_ROLE_KEY=
# Direct Postgres URL for the LangGraph checkpointer (structure build questions wait on it).
# The SESSION pooler string (port 5432) from Dashboard > Connect. Empty = the build
# cannot wait for answers and takes each question's suggested answer (recorded as "defaulted").
SUPABASE__DB_URL=
# The publishable key (sb_publishable_...). Used by the smoke scripts to sign in.
SUPABASE__ANON_KEY=
# Leave empty: hosted sign-in tokens are verified against the project's published keys (JWKS).
SUPABASE__JWT_SECRET=
# Redirect for invite emails (the frontend's accept-invite page).
SUPABASE__INVITE_REDIRECT_URL=http://localhost:3000/auth/accept

# --- API ------------------------------------------------------------------------------------
# Comma-separated origins allowed by CORS (the Next.js frontend).
API__CORS_ORIGINS=http://localhost:3000
# Public base URL of this API, used when building /files/{ticket} links.
API__PUBLIC_URL=http://localhost:8000
# Shared secret functions send to /internal/* callbacks (the courier between hops).
API__INTERNAL_SECRET=change-me-locally
# Where functions reach the API for those callbacks.
API__INTERNAL_URL=http://localhost:8000

# --- Functions dispatch -----------------------------------------------------------------------
# true: POST jobs to local functions-framework servers (scripts/start-functions.ps1).
# false: enqueue on Cloud Tasks with an OIDC token.
LOCAL_FUNCTIONS=true
GCP__PROJECT_ID=
GCP__REGION=asia-south1
GCP__TASKS_QUEUE=hiru-jobs
# Service account Cloud Tasks signs OIDC tokens as (must be allowed to invoke the functions).
GCP__TASKS_INVOKER_SA=
# Base URL of deployed functions; "{function_name}" is substituted when present.
GCP__FUNCTIONS_BASE_URL=

# --- assemble (ffmpeg service: last frame of an accepted take) -----------------------------------
# Locally: run infra/assemble on port 8209. Empty URL = "carry last frame" is unavailable.
ASSEMBLE__URL=
ASSEMBLE__SECRET=

# --- OpenAI (the only LLM provider) -------------------------------------------------------------
# Empty = AI features off: documents are indexed for keyword search only, roles come from rules,
# and search is not reranked. Everything still works; add the key, then re-ingest documents
# and re-run scripts/ingest_knowledge.py to add embeddings.
OPENAI__API_KEY=
# Model ids are configuration: confirm the current OpenAI line-up before changing them.
# Tiers (PLAN.md §5): ultra = structure build, high = planners and canon cards,
# medium = critics, dedupe, roles, rerank; low = headers.
OPENAI__MODEL_ULTRA=gpt-5
OPENAI__MODEL_HIGH=gpt-5
OPENAI__MODEL_MEDIUM=gpt-5-mini
OPENAI__MODEL_LOW=gpt-5-nano
OPENAI__EFFORT_ULTRA=high
OPENAI__EFFORT_HIGH=medium
OPENAI__EFFORT_MEDIUM=low
OPENAI__EFFORT_LOW=minimal
OPENAI__EMBEDDING_MODEL=text-embedding-3-large
# The image tier (PLAN.md §5): first frames and canon reference sheets (frame_render).
OPENAI__MODEL_IMAGE=gpt-image-2
OPENAI__IMAGE_QUALITY=medium
# frame_render looks at each painted frame with this model (who is in it, does it match the shot).
# Empty turns the check off.
OPENAI__MODEL_VISION=gpt-5-mini
# Must match the vector(1536) columns in supabase/migrations.
OPENAI__EMBEDDING_DIMENSIONS=1536

# Functions whose system is migrated to hiru_ai: legacy (default) or graph. Per function, until Phase 8 removes it.
AI_ENGINE=legacy
# Write the per-component columns of token_usage (schema v10: component, component_version, prompt_hash, tool_calls,
# tool_result_tokens; schema v12: reasoning_tokens). Leave off until Database/upgrade_v11_to_v12.sql has been run on the
# project: PostgREST refuses a row that names a column the table lacks.
USAGE_DETAIL=false
# How Shot Planner Adam plans a scene: staged (default; plan/2026-11-04b) or take (one gpt-5 call and a ladder of small
# fixes; plan/2026-11-05). Switch only after the gate in plan/2026-11-05 §7.
ADAM_MODE=staged
# How many scenes Adam plans at once in one delivery (plan/2026-11-05b). Lower it if the OpenAI account's gpt-5 rate
# limits are low; a scene's chain (~11 min staged) is the floor whatever this is.
ADAM_WORKERS=10
# Shot Planner David (plan/2026-11-05e): the model and effort of its author and repairer (the `author` and `repair` tiers),
# and how many scenes it plans at once in one delivery. The spike (scripts/david_spike.py) decides the model (D3).
OPENAI__MODEL_AUTHOR=gpt-5
OPENAI__EFFORT_AUTHOR=medium
OPENAI__EFFORT_REPAIR=low
DAVID_WORKERS=10
# Shot Planner Jonathan (plan/2026-11-06b): its author and reviser use the `jonathan` tier: the same model, at the effort the
# cinematic lab proved (high); and how many scenes it plans at once in one delivery.
OPENAI__EFFORT_JONATHAN=high
JONATHAN_WORKERS=10
# Agents that run as a tool loop instead of one call (plan/2026-11-04 Phase 2), comma-separated: chat_answerer,
# options_writer, translator, shot_critic. Empty = none. Name an agent only after `hiru-ai eval <agent> --ab base,tools
# --live` shows it at least as good; going back is taking its id out.
AGENT_TOOLS=

# Langfuse tracing (ADR 0008): every agent, panel and graph run as one tree per run. Keys from the Langfuse
# project's settings page; empty = no tracing. Needs the `langfuse` package (pip install langfuse==5.2.0).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
