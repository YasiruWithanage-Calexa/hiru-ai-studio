---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	frames(frames)
	reference(reference)
	look(look)
	face(face)
	views(views)
	board(board)
	__end__([<p>__end__</p>]):::last
	__start__ -.-> board;
	__start__ -.-> face;
	__start__ -.-> frames;
	__start__ -.-> look;
	__start__ -.-> reference;
	__start__ -.-> views;
	board --> __end__;
	face --> __end__;
	frames --> __end__;
	look --> __end__;
	reference --> __end__;
	views --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
