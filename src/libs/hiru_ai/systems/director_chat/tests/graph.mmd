	conduct -.-> confirm;
	conduct -.-> edit;
	conduct -.-> follow;
	conduct -.-> options;
	conduct -.-> reshape;
	conduct -.-> settle;
	conduct -.-> translate;
	confirm --> settle;
	edit --> settle;
	follow --> settle;
	options --> settle;
	read -.-> __end__;
