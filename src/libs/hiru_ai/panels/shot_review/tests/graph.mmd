---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	write(write)
	critique(critique)
	revise(revise)
	__end__([<p>__end__</p>]):::last
	__start__ --> write;
	critique -.-> __end__;
	critique -.-> revise;
	revise -.-> __end__;
	revise -.-> critique;
	write --> critique;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
