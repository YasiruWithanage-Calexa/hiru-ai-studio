   {
    "index": 0,
    "kind": "action",
    "text": "The new restaurant on opening evening. KASUN stands by the door, adjusting his shirt, nervous."
   },
   {
    "index": 1,
    "kind": "action",
    "text": "A car stops outside. ANUDI'S FATHER steps out and looks up at the sign."
   },
   {
    "index": 2,
    "kind": "dialogue",
    "speaker": "Father",
    "line_id": "L2",
    "text": "මේක ඔයාගේද?"
   },
   {
    "index": 3,
    "kind": "dialogue",
    "speaker": "Kasun",
    "line_id": "L3",
    "text": "ඔව් සර්. මම ඔයා එනකල් බලා හිටියා."
   },
   {
    "index": 4,
    "kind": "action",
    "text": "The father looks around the room, then at Kasun. He nods, once."
   }
  ]
 },
