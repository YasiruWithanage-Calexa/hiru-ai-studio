{"scene": {"blocks": [{"index": 0, "kind": "action", "text": "A bench by the lake, late afternoon. ANUDI laughs, her phone face-down on the bench between her and DASUN.", "speaker": "", "line_id": null, "delivery": "", "screen": "act", "events": 2, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 1, "kind": "dialogue", "text": "ඉතින් මම කිව්වා, ඕක බොරු!", "speaker": "Dasun", "line_id": "L1", "delivery": "", "screen": "act", "events": 1, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 2, "kind": "action", "text": "Her phone buzzes on the bench. The screen lights: THATHTHA.", "speaker": "", "line_id": null, "delivery": "", "screen": "act", "events": 2, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 3, "kind": "action", "text": "Anudi glances at it, still smiling, and answers.", "speaker": "", "line_id": null, "delivery": "", "screen": "act", "events": 1, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 4, "kind": "dialogue", "text": "දුවේ, ඔයාගේ විවාහය ගැන අපි තීරණය කළා.", "speaker": "Father (on the phone)", "line_id": "L4", "delivery": "", "screen": "act", "events": 1, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 5, "kind": "action", "text": "Her smile begins to fade.", "speaker": "", "line_id": null, "delivery": "", "screen": "with_line", "events": 1, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 6, "kind": "dialogue", "text": "මම එන්නම්, තාත්තේ.", "speaker": "Anudi", "line_id": "L6", "delivery": "quietly", "screen": "act", "events": 1, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 7, "kind": "action", "text": "She ends the call and puts the phone face-down on the bench.", "speaker": "", "line_id": null, "delivery": "", "screen": "act", "events": 1, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 8, "kind": "dialogue", "text": "ආයෙ හම්බවෙමු.", "speaker": "Anudi", "line_id": "L8", "delivery": "restrained", "screen": "act", "events": 1, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}, {"index": 9, "kind": "action", "text": "She picks up her bag and walks out. Dasun watches her go.", "speaker": "", "line_id": null, "delivery": "", "screen": "move", "events": 2, "hold_s": 0.0, "hold_kind": "", "hold_who": "", "turn": false}], "cast": ["Anudi", "Dasun", "Father"], "others": ["Kasun"], "place": {"name": "A bench by the lake, late afternoon", "objects": ["bench", "lake", "phone", "bag", "trees", "water"]}, "envelope_s": 90.0}, "production": {"style_note": "Warm, naturalistic", "people": [{"name": "Anudi", "code": "C01", "look": "pale green kurta"}]}, "context": {"heading": "EXT. LAKE - DAY"}, "link": "", "canon_looks": {"Anudi": "pale green kurta"}}
