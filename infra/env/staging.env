# The test environment's settings (plan/2026-11-27 §6): the SAME list for the API (scripts/deploy_api.ps1) and the
# functions (scripts/deploy_functions.ps1), so the cloud behaves as localhost does. No secrets here: those live in
# Secret Manager. Addresses (Supabase, the API, queue, assemble) come from `terraform output` at deploy time.
ENVIRONMENT=staging
LOCAL_FUNCTIONS=false

# Where stored files live. `supabase` until the media move (plan §4); then `gcs` with fallback `true`, copy, `false`.
# Change it here AND in localhost's .env at the same time: they share one database.
FILES__BACKEND=gcs
FILES__GCS_BUCKET=scenecraft-test-media
FILES__READ_FALLBACK=true

ADAM_MODE=take
ADAM_WORKERS=10
USAGE_DETAIL=true
ZORA__ENABLED=true
LIVE__TRANSPORT=poll

VIDEO__FAKE_PROVIDER=false
VIDEO__MAX_RUNNING_PER_PRODUCTION=4

OPENAI__MODEL_ULTRA=gpt-5
OPENAI__MODEL_HIGH=gpt-5
OPENAI__MODEL_MEDIUM=gpt-5-mini
OPENAI__MODEL_LOW=gpt-5-nano
OPENAI__EFFORT_ULTRA=high
OPENAI__EFFORT_HIGH=medium
OPENAI__EFFORT_MEDIUM=low
OPENAI__EFFORT_LOW=minimal
OPENAI__EMBEDDING_MODEL=text-embedding-3-large
OPENAI__EMBEDDING_DIMENSIONS=1536
OPENAI__IMAGE_QUALITY=low
