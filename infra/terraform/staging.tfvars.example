# Copy to staging.tfvars (gitignored) and fill in:
#   terraform init -backend-config="bucket=<project_id>-tfstate"
#   terraform workspace new staging   # one workspace per environment
#   terraform apply -var-file=staging.tfvars
project_id   = "your-project-id"
environment  = "staging"
region       = "asia-southeast1"
supabase_url = "https://<ref>.supabase.co"
media_bucket = "your-media-bucket" # = FILES__GCS_BUCKET in infra/env/staging.env
api_domain   = ""                  # e.g. api.example.com; empty = <address>.sslip.io
alert_email  = ""
